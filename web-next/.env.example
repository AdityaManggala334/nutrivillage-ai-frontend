# Salin file ini menjadi `.env.local` saat menjalankan frontend TANPA Docker.
#
#   cp .env.example .env.local
#
# Catatan: saat memakai Docker (docker-compose.full.yml), variabel ini sudah
# diisi otomatis oleh compose — tidak perlu file ini.

# HARUS sama persis dengan JWT_SECRET di repo backend (.env / compose).
JWT_SECRET=nutrivillage-dev-secret-change-me

# URL backend FastAPI. Default pengembangan lokal:
API_BASE_URL=http://127.0.0.1:8000
API_PREFIX=/api/v1
